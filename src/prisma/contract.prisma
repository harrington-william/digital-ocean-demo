// use prisma-8

model Author {
  id        BigInt   @id @default(autoincrement())
  name      VarChar(255)
  biography String?
  books     Book[]
  createdAt TimestamptzString @default(now()) @map("created_at")

  @@map("authors")
}

model Book {
  id            BigInt        @id @default(autoincrement())
  author        Author        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId      BigInt        @map("author_id")
  title         VarChar(255)
  isbn          VarChar(13)?  @unique
  publishedYear SmallInt?     @map("published_year")
  @@map("books")
  @@index([authorId], name: "idx_books_author_id")
}
